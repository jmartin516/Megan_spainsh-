# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# OpenAI API Key (get from platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Student name (default: Megan)
STUDENT_NAME=Megan

# Timezone for daily word (default: America/Los_Angeles)
# Examples: Europe/Madrid, America/New_York, Europe/London
TIMEZONE=America/Los_Angeles

# TTS Speed (0.5 = slow, 1.0 = normal, 2.0 = fast)
# Default: 0.9 (slightly slower for learners)
TTS_SPEED=0.9
